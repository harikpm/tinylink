datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

model Link {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  targetUrl   String
  totalClicks Int       @default(0)
  lastClicked DateTime?
  createdAt   DateTime  @default(now())
}
